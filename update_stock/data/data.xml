<odoo>
    <record id="seq_update_stock" model="ir.sequence">
        <field name="name">Secuencia Ajustes Stock</field>
        <field name="code">update.stock</field>
        <field name="implementation">no_gap</field>
        <field name="prefix">AJU-</field>
        <field name="padding">3</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>

    <record id="seq_update_barcode" model="ir.sequence">
        <field name="name">Secuencia Códigos de Barras</field>
        <field name="code">update.barcode</field>
        <field name="implementation">no_gap</field>
        <field name="prefix">%(y)s</field>
        <field name="padding">9</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>
</odoo>
